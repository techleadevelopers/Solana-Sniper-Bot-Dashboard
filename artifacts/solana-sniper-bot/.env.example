# Optional API origin only; the OpenAPI contract appends /api routes.
# Leave blank to use same-origin requests.
VITE_API_BASE_URL=

# Optional full ws:// or wss:// URL. Defaults to the API host's /ws/events.
VITE_WS_URL=

# Provisioned by Replit Clerk Auth; do not replace with a secret key.
VITE_CLERK_PUBLISHABLE_KEY=

# Deployment-managed Clerk proxy URL; typically left empty during development.
VITE_CLERK_PROXY_URL=
